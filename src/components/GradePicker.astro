---
// 칠판 아래 분필받침. 학년 분필을 집으면 그 학년 알림만 보인다.
interface Props {
  attached?: boolean; // 칠판 바로 밑에 붙일 때
}

const { attached = false } = Astro.props;
const options = [
  { value: '', label: '전체' },
  { value: '1', label: '1학년' },
  { value: '2', label: '2학년' },
  { value: '3', label: '3학년' },
];
---

<div class:list={['tray', { 'tray-attached': attached }]} id="grade-tray">
  <fieldset>
    <legend>학년별로 보기</legend>
    <div class="chalks">
      {
        options.map((o) => (
          <button type="button" class="chalk" data-value={o.value} aria-pressed={o.value === '' ? 'true' : 'false'}>
            <span>{o.label}</span>
          </button>
        ))
      }
    </div>
  </fieldset>
  <span class="eraser" aria-hidden="true"></span>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tray .chalk');
  // 휴대폰 머리글의 학년 표시. 누르면 분필받침으로 내려간다.
  const chip = document.querySelector<HTMLElement>('[data-grade-chip]');
  if (chip) chip.hidden = false;

  function show(grade: string) {
    if (grade) document.documentElement.dataset.grade = grade;
    else delete document.documentElement.dataset.grade;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.value === grade)));
    if (chip) chip.textContent = grade ? `${grade}학년` : '전체 학년';
  }

  show(document.documentElement.dataset.grade ?? '');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const grade = b.dataset.value ?? '';
      show(grade);
      try {
        if (grade) localStorage.setItem('mjms-grade', grade);
        else localStorage.removeItem('mjms-grade');
      } catch {}
    }),
  );
</script>
