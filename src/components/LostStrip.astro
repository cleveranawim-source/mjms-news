---
// 첫 화면의 분실물 띠. AI 교무실에서 보관 중 물건을 받아 오고, 못 받으면 칸째 감춘다.
import { site } from '../site.config.ts';
import { href } from '../lib/paths.ts';
---

{
  site.lostFoundApi && (
    <section class="section lost-strip" aria-labelledby="lost-strip-title" data-lost-strip data-api={site.lostFoundApi} hidden>
      <div class="section-head">
        <h2 id="lost-strip-title">
          주인을 기다리는 물건 <span data-lost-count />
        </h2>
        <a href={href('lost/')}>분실물함 열기</a>
      </div>
      <a class="strip-viewport" href={href('lost/')} aria-label="분실물함에서 사진 크게 보기">
        <ul class="strip" data-lost-list />
      </a>
      <p class="strip-note">내 물건이 보이면 사진 아래 적힌 곳의 선생님께 물건의 특징을 말하고 찾아가요.</p>
    </section>
  )
}

<script>
  import { loadLost, stripItemHTML } from '../lib/lost.ts';

  const section = document.querySelector<HTMLElement>('[data-lost-strip]');
  if (section) {
    const items = await loadLost(section.dataset.api!);
    if (items && items.length > 0) {
      const list = section.querySelector<HTMLElement>('[data-lost-list]')!;
      section.querySelector('[data-lost-count]')!.textContent = `${items.length}개`;
      list.innerHTML = items.map(stripItemHTML).join('');
      section.hidden = false;
      // 한 줄에 다 안 들어가면 같은 줄을 한 번 더 붙여 끊김 없이 흘려 보낸다.
      const viewport = section.querySelector<HTMLElement>('.strip-viewport')!;
      if (list.scrollWidth > viewport.clientWidth) {
        list.insertAdjacentHTML('beforeend', items.map(stripItemHTML).join('').replaceAll('<li>', '<li aria-hidden="true">'));
        list.style.setProperty('--flow-s', `${items.length * 3}s`);
        list.dataset.flow = 'true';
      }
    }
  }
</script>
