---
// 반 고르기: 학년 분필받침 아래에 그 학년의 반 단추가 한 줄로 나온다. 반 목록은 시간표 피드에서 오므로
// 단추는 시간표 화면의 스크립트가 채운다. 고른 반은 이 기기(localStorage `mjms-class`)에만 저장된다.
import GradePicker from './GradePicker.astro';
---

<div class="class-picker" data-class-picker>
  <GradePicker />
  <div class="class-row" role="group" aria-label="반 고르기">
    <p class="class-hint" data-class-hint>학년을 먼저 골라 주세요.</p>
    <div class="class-btns" data-class-btns></div>
  </div>
</div>
