---
// 첫 화면의 급식 칸. 빌드한 날 기준으로 먼저 그려 두고, 브라우저가 실제 오늘 날짜로 다시 그린다.
import { getFeed } from '../lib/feed.ts';
import { buildToday } from '../lib/dates.ts';
import { pickMeal, mealHTML } from '../lib/meal.ts';

const { meals, daysOff } = await getFeed();
const today = buildToday();
const html = mealHTML(pickMeal(today, meals, daysOff));
---

<section class="section meal-card" aria-labelledby="meal-title" data-meal data-today={today} hidden={!html}>
  <div data-meal-body set:html={html} />
  <script type="application/json" data-meal-json set:html={JSON.stringify({ meals, daysOff }).replace(/</g, '\\u003c')} />
</section>

<script>
  import { seoulToday } from '../lib/dates.ts';
  import { pickMeal, mealHTML } from '../lib/meal.ts';

  const card = document.querySelector<HTMLElement>('[data-meal]');
  const today = seoulToday();
  if (card && card.dataset.today !== today) {
    const { meals, daysOff } = JSON.parse(card.querySelector('[data-meal-json]')!.textContent!);
    const html = mealHTML(pickMeal(today, meals, daysOff));
    card.dataset.today = today;
    card.querySelector('[data-meal-body]')!.innerHTML = html;
    card.hidden = !html;
  }
</script>
