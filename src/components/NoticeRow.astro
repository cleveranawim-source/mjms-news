---
import { formatDate } from '../lib/dates.ts';
import type { FeedLetter } from '../lib/feed.ts';
import { gradesOrAll } from '../lib/content.ts';
import { gradeLabel } from '../lib/grades.ts';
import { href } from '../lib/paths.ts';
import GradeDots from './GradeDots.astro';

interface Props {
  letter: FeedLetter;
}

const l = Astro.props.letter;
const grades = gradesOrAll(l.grades);
// 학급이 정해진 알림은 「1학년 5반」처럼 반까지 적는다.
const target = l.classes ?? gradeLabel(grades);
---

<li data-grades={grades.join(' ')}>
  <a class="row" href={href(`notices/${l.id}/`)}>
    <span class="row-date">{formatDate(l.postedOn)}</span>
    <span class="row-title">{l.number && <span class="row-no">{l.number}</span>}{l.subject}</span>
    <span class="row-meta">
      <span class="grade-label"><GradeDots grades={grades} />{target}</span>
      {l.bring.length > 0 && <span>준비물 있음</span>}
    </span>
  </a>
</li>
