---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import EventRow from '../components/EventRow.astro';
import { getScheduleEntries, groupByMonth } from '../lib/content.ts';
import { formatMonth } from '../lib/dates.ts';

const months = groupByMonth(await getScheduleEntries(), (e) => e.start);
---

<Base title="학사일정">
  <Plate kind="page" title="학사일정" />
  <p class="lede">시험, 행사, 쉬는 날을 날짜순으로 모았습니다. 지난 일정은 흐리게 보입니다.</p>
  {
    months.map(([month, items]) => (
      <section class="month filter-group">
        <h2>{formatMonth(`${month}-01`)}</h2>
        <ul class="lined">
          {items.map((e) => <EventRow event={e} />)}
        </ul>
        <p class="list-empty">이 달에는 해당 학년 일정이 없습니다.</p>
      </section>
    ))
  }
</Base>

<script>
  import { seoulToday } from '../lib/dates.ts';

  const today = seoulToday();
  document.querySelectorAll<HTMLElement>('[data-start]').forEach((li) => {
    const { start = '', end = '' } = li.dataset;
    li.classList.toggle('is-past', end < today);
    li.classList.toggle('is-today', start <= today && today <= end);
  });
</script>
