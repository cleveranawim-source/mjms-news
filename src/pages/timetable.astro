---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import { buildToday, offRanges } from '../lib/dates.ts';
import { getFeed } from '../lib/feed.ts';
import { site } from '../site.config.ts';

// 「학교 행사」로만 적힌 바뀐 칸에 붙일 학사일정 이름: 빌드한 날부터의 행사만 싣는다.
const today = buildToday();
const feed = await getFeed();
const events = (feed.schedule ?? []).filter((e) => e.kind === 'event' && e.end >= today);
// 알림장이 쉬는 날로 아는 날(달력·칠판과 같은 기준): 시간표 피드가 수업일로 보내도 쉬는 날로 그린다.
const offs = offRanges(feed).filter((o) => o.end >= today);
// <script> 안의 JSON이 </script>로 끊기지 않도록 <를 이스케이프한다.
const eventsJson = JSON.stringify(events).replace(/</g, '\\u003c');
const offsJson = JSON.stringify(offs).replace(/</g, '\\u003c');
---

<Base title="시간표" description="우리 반 이번 주·다음 주 시간표와 오늘 바뀐 수업을 한눈에 볼 수 있습니다.">
  <Plate kind="class" title=" 시간표" compact />
  {
    site.timetableApi && (
      <div class="tt" data-timetable data-api={site.timetableApi}>
        <p class="lede" data-tt-message role="status">시간표를 불러오는 중이에요.</p>
        <noscript><p class="lede">시간표는 자바스크립트를 켜야 보여요.</p></noscript>
        <div class="tt-pick" data-tt-pick hidden>
          <p class="lede">우리 반을 한 번 골라 두면 다음부터 바로 보여요. 고른 반은 이 기기에만 저장돼요.</p>
          <button type="button" class="tt-btn tt-btn--fill" data-open-class-sheet aria-haspopup="dialog">반 고르기</button>
        </div>
        <div class="tt-error" data-tt-error hidden>
          <p role="alert">시간표를 불러오지 못했어요</p>
          <button type="button" class="tt-btn" data-tt-retry>다시 불러오기</button>
        </div>
        <div class="tt-view" data-tt-view hidden>
          <div class="tt-weeks" role="group" aria-label="주 고르기" data-tt-weeks />
          <div data-tt-changes />
          {/* 표가 판보다 실제로 넓을 때만 보이는 안내(스크립트가 재서 켠다). 끝까지 밀어도 틀리지 않는 말로. */}
          <p class="tt-scroll-note" id="tt-scroll-note" data-tt-scroll hidden>옆으로 밀면 다른 요일도 볼 수 있어요</p>
          <div class="tt-panel-wrap">
            <div class="tt-panel" data-tt-grid role="region" aria-label="주간 시간표" tabindex="0" />
            {/* 판 오른쪽의 흰 그늘 + 꺾쇠: 표가 잘리고 아직 끝까지 안 밀었을 때만(스크립트). 읽기 프로그램에는 위 안내 글이 있다. */}
            <span class="tt-more" data-tt-more aria-hidden="true" hidden><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg></span>
          </div>
          <p class="tt-legend"><b>굵은 남색</b> = 바뀐 수업(줄 그은 과목이 원래 수업)</p>
        </div>
        <script type="application/json" data-tt-events set:html={eventsJson} />
        <script type="application/json" data-tt-offs set:html={offsJson} />
      </div>
    )
  }
</Base>

<script>
  import { loadTimetable, markDaysOff, nameSchoolEvents, weekTableHTML, changesTarget, changesBoxHTML, weekChangesBoxHTML, weekGroups, weekRange, mondayOf, moreToScroll, type TimetableFeed } from '../lib/timetable.ts';
  import { readClass, knownClass, forgetStaleClass } from '../lib/klass.ts';
  import { seoulToday, addDays, weekday } from '../lib/dates.ts';
  import { escapeHTML } from '../lib/html.ts';

  const root = document.querySelector<HTMLElement>('[data-timetable]');
  if (root) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const message = $('[data-tt-message]');
    const pick = $('[data-tt-pick]');
    const error = $('[data-tt-error]');
    const view = $('[data-tt-view]');
    const weeksEl = $('[data-tt-weeks]');
    const panel = $('[data-tt-grid]');
    const scrollNote = $('[data-tt-scroll]');
    const more = $('[data-tt-more]');
    // 화면을 열어 둔 채 날이 바뀌면 돌아왔을 때 다시 맞춘다(revisit).
    let today = seoulToday();
    const events = JSON.parse($('[data-tt-events]').textContent!);
    const offs = JSON.parse($('[data-tt-offs]').textContent!);
    // 돌아왔을 때 이만큼 지났으면 시간표를 다시 받는다 — AI 교무실 시간표 캐시(max-age=60)와 같다.
    const STALE_MS = 60_000;
    let loadedAt = 0;

    // undefined = 불러오는 중, null = 못 불러옴
    let feed: TimetableFeed | null | undefined;
    let groups: ReturnType<typeof weekGroups> = [];
    let week = 0;
    let classId = readClass();
    let ticket = 0;

    // 처음 보일 주: 오늘이 든 주, 주말이면 다음 주(그 주가 없으면 첫 주).
    const firstWeek = () => {
      const wd = weekday(today);
      const start = wd === '토' ? addDays(today, 2) : wd === '일' ? addDays(today, 1) : today;
      return Math.max(0, groups.findIndex((w) => mondayOf(w.days[0]) === mondayOf(start)));
    };
    const weekDays = () => {
      const m = mondayOf(groups[week].days[0]);
      return [0, 1, 2, 3, 4].map((i) => addDays(m, i));
    };
    // 주 단추는 모두 같은 꼴: 이름 위, 날짜 범위 아래(「이번 주 / 10/19~23」).
    const weekText = (i: number) => {
      const w = groups[i];
      return `${escapeHTML(w.label)} <small>${weekRange(mondayOf(w.days[0]))}</small>`;
    };

    // 가로 안내: 표가 판보다 실제로 넓을 때(scrollWidth > clientWidth + 1)만 보인다. 화면 폭이 아니라 실제 치수로 판단한다.
    // 판과 표를 함께 지켜본다 — 판 폭은 그대로여도 글자를 키우거나 글꼴이 늦게 와서 표만 넓어질 수 있다. 한 프레임에 한 번만 잰다.
    let watched: Element | null = null;
    let raf = 0;
    const measureScroll = () => {
      raf = 0;
      const table = panel.querySelector('table');
      const over = !view.hidden && !!table && panel.clientWidth > 0 && panel.scrollWidth > panel.clientWidth + 1;
      scrollNote.hidden = !over;
      // 오른쪽 꺾쇠는 아직 끝까지 안 밀었을 때만(끝에 닿으면 감춘다)
      more.hidden = !(over && moreToScroll(panel));
      // 읽기 프로그램에는 보일 때만 판 설명으로 잇는다(resize마다 읊지 않게 live 영역은 쓰지 않는다).
      if (over) panel.setAttribute('aria-describedby', scrollNote.id);
      else panel.removeAttribute('aria-describedby');
    };
    const scheduleMeasure = () => {
      if (!raf) raf = requestAnimationFrame(measureScroll);
    };
    const watcher = new ResizeObserver(scheduleMeasure);
    watcher.observe(panel);
    const watchTable = () => {
      const table = panel.querySelector('table');
      if (table === watched) return;
      if (watched) watcher.unobserve(watched);
      watched = table;
      if (table) watcher.observe(table);
      scheduleMeasure();
    };
    document.fonts?.ready.then(scheduleMeasure);
    addEventListener('pageshow', scheduleMeasure);
    panel.addEventListener('scroll', scheduleMeasure, { passive: true });

    // 주 단추는 그대로 두고 눌림·글자와 표만 바꾼다(포커스가 단추에 남도록).
    const renderGrid = (cls: TimetableFeed['classes'][number]) => {
      weeksEl.querySelectorAll<HTMLElement>('[data-week]').forEach((b) => {
        const i = Number(b.dataset.week);
        b.setAttribute('aria-pressed', String(i === week));
        b.firstElementChild!.innerHTML = weekText(i);
      });
      const days = weekDays();
      // 안내판은 보고 있는 주를 따른다: 오늘(다음 등교일)이 그 주에 있으면 그날 것, 아니면 그 주 바뀐 수업 전부.
      const t = changesTarget(cls, today);
      $('[data-tt-changes]').innerHTML = days.includes(t.ymd) ? changesBoxHTML(cls, t.ymd, t.label, t.empty, t.date) : weekChangesBoxHTML(cls, days);
      panel.innerHTML = weekTableHTML(cls, days, today);
      watchTable();
    };

    const mine = () => (feed ? feed.classes.find((c) => c.id === knownClass(feed!.classes, classId)) : undefined);

    const render = () => {
      // 반이 없거나 피드에 없는 반 → 고르기 안내. 반이 있으면 불러오는 중 / 못 불러옴 / 표.
      const has = feed ? !!mine() : !!classId;
      pick.hidden = has;
      message.hidden = !has || feed !== undefined;
      error.hidden = !has || feed !== null;
      view.hidden = !has || !feed;
      const cls = mine();
      if (!cls) return scheduleMeasure(); // 표가 숨으면 안내도 숨는다
      if (weeksEl.childElementCount !== groups.length) {
        weeksEl.style.setProperty('--n', String(groups.length));
        weeksEl.innerHTML = groups.map((_, i) => `<button type="button" data-week="${i}" aria-pressed="false"><span></span></button>`).join('');
      }
      renderGrid(cls);
    };

    // 늦게 온 답이라 버렸으면 false.
    // quiet(돌아왔을 때 다시 받기): 보이던 표를 그대로 둔 채 받고, 보던 주를 지키며, 못 받으면 보이던 표를 그대로 둔다.
    const load = async (quiet = false) => {
      const my = ++ticket;
      if (!quiet) {
        feed = undefined;
        render();
      }
      const got = markDaysOff(nameSchoolEvents(await loadTimetable(root.dataset.api!), events), offs);
      if (my !== ticket) return false; // 그새 다시 불렀으면 늦게 온 답은 버린다
      const fresh = got && got.classes.length && got.days.length ? got : null;
      if (quiet && !fresh) return true;
      const seen = quiet && groups[week] ? mondayOf(groups[week].days[0]) : null;
      feed = fresh;
      loadedAt = Date.now();
      if (feed) {
        groups = weekGroups(feed.days, today);
        const kept = seen ? groups.findIndex((w) => mondayOf(w.days[0]) === seen) : -1;
        week = kept >= 0 ? kept : firstWeek();
        // 조용히 받을 때는 주 단추를 지우지 않는다(초점이 남게) — 수가 달라지면 render가 다시 만든다.
        if (!quiet) weeksEl.innerHTML = '';
        // 저장된 반이 피드에 없으면 지우고 알린다(명패·본문이 「반 고르기」로).
        forgetStaleClass(feed.classes);
      }
      render();
      return true;
    };

    // 다른 앱·탭에 갔다 돌아왔을 때: 날이 바뀌었으면 「오늘」과 처음 보일 주를 다시 잡고, 받은 지 오래됐으면 조용히 다시 받는다.
    const revisit = () => {
      if (document.visibilityState !== 'visible' || feed === undefined) return;
      const now = seoulToday();
      const newDay = now !== today;
      if (!newDay && Date.now() - loadedAt < STALE_MS) return;
      today = now;
      if (!feed) return void load(); // 못 불러온 채였으면 다시 불러 본다
      if (newDay) {
        groups = weekGroups(feed.days, today);
        week = firstWeek();
        render();
      }
      load(true);
    };
    document.addEventListener('visibilitychange', revisit);
    addEventListener('pageshow', (e) => {
      if (e.persisted) revisit();
    });

    document.addEventListener('mjms:class', (e) => {
      classId = (e as CustomEvent<string>).detail;
      // 반 고르기 창이 닫히기 전에 바로 그린다(본문 「반 고르기」가 숨어 포커스가 명패 단추로 간다).
      if (feed === null) load();
      else render();
    });

    root.addEventListener('click', async (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-week], [data-tt-retry]');
      if (!t) return;
      if (t.dataset.week) {
        week = Number(t.dataset.week);
        const cls = mine();
        if (cls) renderGrid(cls);
        return;
      }
      // 다시 불러오기: 단추가 잠깐 사라지므로 결과(바뀐 수업 안내판 제목, 또 실패면 그 단추)로 포커스를 옮긴다.
      // 답을 버렸거나 저장된 반이 피드에 없으면 보이는 「반 고르기」 단추로.
      const fresh = await load();
      let next: HTMLElement | null = null;
      if (fresh && feed === null) next = $('[data-tt-retry]');
      else if (fresh && mine()) {
        next = root.querySelector<HTMLElement>('#tt-changes-title');
        if (next) next.tabIndex = -1;
      }
      next ??= pick.hidden ? document.querySelector<HTMLElement>('.plate-btn') : pick.querySelector<HTMLElement>('[data-open-class-sheet]');
      next?.focus();
    });

    load();
  }
</script>
