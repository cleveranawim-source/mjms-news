---
import Base from '../../layouts/Base.astro';
import GradeBadge from '../../components/GradeBadge.astro';
import { getLetters, sourceLabel } from '../../lib/content.ts';
import { usableDue } from '../../lib/board.ts';
import { formatDate, formatRange } from '../../lib/dates.ts';
import { href } from '../../lib/paths.ts';

export async function getStaticPaths() {
  return (await getLetters()).map((letter) => ({ params: { id: letter.id }, props: { letter } }));
}

const { letter: l } = Astro.props;
// 요약은 줄바꿈마다 문단으로 나눈다. 텍스트로만 넣어 HTML이 섞여도 글자로 보인다.
const paragraphs = l.summary.split(/\n+/).map((p) => p.trim()).filter(Boolean);
---

<Base title={l.subject}>
  <a class="back-link" href={href('notices/')}>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
    가정통신문
  </a>
  <article class="letter">
    <header class="letter-head">
      <img src={href('emblem.png')} alt="" width="28" height="29" />
      <p class="letter-org"><small>가정통신문</small><b>명지중학교</b></p>
      {l.number && <span class="letter-no">{l.number}</span>}
    </header>
    <h1 class="letter-title">{l.subject}</h1>
    <dl class="facts">
      <div><dt>대상</dt><dd><GradeBadge grades={l.grades} />{l.classes && <span class="facts-classes">{l.classes}</span>}</dd></div>
      {l.eventDate && <div><dt>일정</dt><dd>{formatRange(l.eventDate, l.eventEnd ?? undefined)}</dd></div>}
      {l.bring.length > 0 && <div><dt>준비물</dt><dd>{l.bring.join(', ')}</dd></div>}
      {/* 행사 뒤로 잡힌 「챙길 날」(이의신청 마감 등)은 준비물 날이 아니라 쓰지 않는다. 행사 기간은 「일정」 줄에 있다. */}
      {usableDue(l) && <div><dt>준비물 챙길 날</dt><dd>{formatDate(usableDue(l)!)}</dd></div>}
      <div><dt>게시일</dt><dd>{formatDate(l.postedOn)}</dd></div>
    </dl>
    <p class="facts-note">
      요약은 AI가 만들고 선생님이 확인했어요. 원문과 다르면 원문이 맞아요.
      {/^https?:\/\//.test(l.sourceUrl) && <a class="tap-inline" href={l.sourceUrl} target="_blank" rel="noopener noreferrer">원문 보기</a>}
    </p>

    <div class="letter-body">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>

    {l.attachments.length > 0 && <p class="files">함께 온 파일: {l.attachments.join(', ')}</p>}

    {
      /^https?:\/\//.test(l.sourceUrl) && (
        <a class="letter-src" href={l.sourceUrl} target="_blank" rel="noopener noreferrer">
          {sourceLabel(l.sourceUrl)}
        </a>
      )
    }
  </article>
  <button class="letter-print" type="button" onclick="window.print()">이 가정통신문 인쇄하기</button>
  <script is:inline define:vars={{ id: l.id }}>
    // 이 기기에서 연 글로 적어 둔다(목록·첫 화면의 「새 글」이 꺼진다). 꼴은 lib/read.ts와 같다: JSON 배열, 최근 200개.
    try {
      let ids = JSON.parse(localStorage.getItem('mjms-read') || '[]');
      if (!Array.isArray(ids)) ids = [];
      ids = ids.filter((x) => typeof x === 'string' && x !== id);
      localStorage.setItem('mjms-read', JSON.stringify([...ids, id].slice(-200)));
    } catch {}
  </script>
</Base>
