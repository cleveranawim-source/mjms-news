---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import Chalkboard from '../components/Chalkboard.astro';
import Sign from '../components/Sign.astro';
import { getSchedule } from '../lib/content.ts';
import { buildToday, formatShortRange, offRanges } from '../lib/dates.ts';
import { getFeed } from '../lib/feed.ts';
import { badgeHTML, scheduleBadgeHTML } from '../lib/grades.ts';
import { LETTERS_N, UPCOMING_N, newLetterRows, upcomingRows } from '../lib/home.ts';
import { mealHTML, noLunchRanges, pickMeal } from '../lib/meal.ts';
import { base, href } from '../lib/paths.ts';
import { site } from '../site.config.ts';

// 칠판·급식은 브라우저가 서울 날짜로 다시 그린다. 일정·가정통신문 판은 매일 아침 빌드 기준이면 된다.
const feed = await getFeed();
const today = buildToday();
const meal = pickMeal(today, feed.meals, offRanges(feed));
const upcoming = upcomingRows(await getSchedule(), today);
const letters = newLetterRows(feed.letters, today);
---

<Base>
  <Plate kind="brand" />
  <div class="home">
    <Chalkboard />
    <section class="sign sign--meal" aria-labelledby="meal-title" data-meal-sign hidden={!meal} set:html={mealHTML(meal, noLunchRanges(feed.letters), base)} />

    <Sign title="다가오는 일정" id="upcoming" link={{ href: href('schedule/'), label: '달력' }} class="sign--views">
      {
        upcoming === null ? (
          <p class="sign-note">학사일정을 불러오지 못했어요. 잠시 뒤 다시 열어 주세요.</p>
        ) : (
          <>
            <ul class="sign-rows sign-rows--dated" data-cap={UPCOMING_N}>
              {upcoming.map(({ item, show, spare }) => (
                <li data-show={show} data-spare={spare || undefined} data-start={item.start}>
                  <span class="sign-date">{formatShortRange(item.start, item.end)}</span>
                  <span class="sign-title">{item.title}</span>
                  <Fragment set:html={scheduleBadgeHTML(item)} />
                </li>
              ))}
            </ul>
            <p class="sign-note sign-empty">다가오는 학사일정이 없어요</p>
          </>
        )
      }
    </Sign>

    <Sign title="새 가정통신문" id="new-letters" link={{ href: href('notices/'), label: '전체' }} class="sign--views">
      <ul class="sign-rows" data-cap={LETTERS_N}>
        {
          letters.map(({ item, show, spare }) => (
            <li data-show={show} data-spare={spare || undefined} data-published={item.publishedOn} data-letter-id={item.id}>
              <a href={href(`notices/${item.id}/`)}>
                <span class="sign-title">{item.subject}</span>
                <Fragment set:html={badgeHTML(item.grades)} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="sign-note sign-empty">2주 안에 새 가정통신문이 없어요</p>
    </Sign>

    {
      site.lostFoundApi && (
        <Sign title="분실물" id="lost-title" link={{ href: href('lost/'), label: '분실물함' }} class="sign--lost" data-lost-sign data-api={site.lostFoundApi} hidden>
          <p class="sign-note">주인을 기다리는 물건이 있어요.</p>
        </Sign>
      )
    }
  </div>
</Base>

<script>
  import { addDays, seoulToday } from '../lib/dates.ts';
  import { visibleShows } from '../lib/home.ts';
  import { loadLost } from '../lib/lost.ts';
  import { readIds } from '../lib/read.ts';

  // 일정·가정통신문 판은 빌드한 날 기준이다. 아침 빌드를 놓쳐도 오늘·지난 일정(오늘 것은 칠판에), 2주 지난 글은 브라우저가 뺀다.
  // 빌드는 보기마다 예비 줄을 더 실어 두므로, 뺀 뒤 보기마다 앞에서 n개를 다시 고른다.
  const today = seoulToday();
  for (const li of document.querySelectorAll<HTMLElement>('[data-start]')) if (li.dataset.start! <= today) li.remove();
  for (const li of document.querySelectorAll<HTMLElement>('[data-published]')) if (li.dataset.published! < addDays(today, -14)) li.remove();
  for (const ul of document.querySelectorAll<HTMLElement>('[data-cap]')) {
    const lis = [...ul.querySelectorAll<HTMLElement>(':scope > li')];
    const shows = visibleShows(lis.map((li) => ({ show: li.dataset.show ?? '', spare: li.dataset.spare ?? '' })), Number(ul.dataset.cap));
    lis.forEach((li, i) => (li.dataset.show = shows[i]));
  }

  // 새 가정통신문 판: 이 기기에서 아직 안 연 글은 굵게, 제목 옆에 「안 읽은 글 N」(보이는 줄만 센다). 다 읽으면 없어진다.
  const read = readIds();
  const unread = [...document.querySelectorAll<HTMLElement>('[data-letter-id]')].filter((li) => !read.has(li.dataset.letterId!));
  for (const li of unread) li.classList.add('is-unread');
  const shown = unread.filter((li) => li.checkVisibility?.() ?? li.offsetParent !== null).length;
  if (shown > 0) document.querySelector('#new-letters')?.insertAdjacentHTML('beforeend', ` <span class="sign-count">안 읽은 글 ${shown}</span>`);

  // 분실물 판: 보관 중인 물건이 있을 때만 「분실물 N개」로 보인다. 못 받거나 0개면 감춘 채로 둔다.
  const sign = document.querySelector<HTMLElement>('[data-lost-sign]');
  if (sign) {
    const items = await loadLost(sign.dataset.api!);
    if (items && items.length > 0) {
      sign.querySelector('[data-sign-title]')!.textContent = `분실물 ${items.length}개`;
      sign.hidden = false;
    }
  }
</script>
