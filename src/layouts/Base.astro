---
import '../styles/global.css';
import { site } from '../site.config.ts';
import { href } from '../lib/paths.ts';
import ClassSheet from '../components/ClassSheet.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} | ${site.title}` : site.title;
const path = Astro.url.pathname;
// 아래 탭(휴대폰·넓은 화면 모두). icon은 24×24 선 그림. 「가정<wbr>통신문」: 글자를 키워 칸이 좁아지면 낱말 사이에서만 줄을 바꾼다.
// 탭 순서(2026-10-31): 오늘 · 시간표 · 일정 · 분실물 · 가정통신문 — 아침에 자주 여는 것부터.
// 아이콘은 닫힌 도형 하나 + 안쪽 선: 지금 화면 탭은 도형을 남색으로 채우고 선을 흰색으로 그린다(CSS).
const nav = [
  { label: '오늘', to: href(), icon: '<path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M10 20v-5h4v5"/>' },
  ...(site.timetableApi
    ? [{ label: '시간표', to: href('timetable/'), icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>' }]
    : []),
  { label: '일정', to: href('schedule/'), icon: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>' },
  ...(site.lostFoundApi
    ? [{ label: '분실물', to: href('lost/'), icon: '<path d="M3 8l9-5 9 5v8l-9 5-9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/>' }]
    : []),
  { label: '가정<wbr>통신문', to: href('notices/'), icon: '<path d="M6 3h11a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H6z"/><path d="M9 8h6M9 12h6M9 16h4"/>' },
];
const isCurrent = (to: string) => (to === href() ? path === to : path.startsWith(to));
// 이용 안내 화면에서는 바닥글이 자기 자신을 가리키지 않게 한다.
const onAbout = path.startsWith(href('about/'));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#033e7b" />
    <title>{fullTitle}</title>
    <link rel="icon" href={href('favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    <link rel="manifest" href={href('manifest.webmanifest')} />
    <meta name="apple-mobile-web-app-title" content="명지중 알림장" />
    <script is:inline>
      // 고른 반(예 class-1_5)은 이 기기에만 저장된다. 학년(1~3만)은 반에서 얻는다. 예전에 따로 두던 mjms-grade는 지운다.
      try {
        localStorage.removeItem('mjms-grade');
        const m = /^class-(\d+)_\d+$/.exec(localStorage.getItem('mjms-class') || '');
        const g = m ? Number(m[1]) : 0;
        if (g >= 1 && g <= 3) document.documentElement.dataset.grade = String(g);
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        {!onAbout && <p><a class="footer-link" href={href('about/')}>이용 안내</a></p>}
        <p>이 사이트는 로그인이 없고, 방문자의 개인정보나 쿠키를 수집하지 않습니다.</p>
        <p>개별 상담과 서류 제출은 학교 공식 창구를 이용해 주세요.</p>
        {/* 연락처는 문장에 섞지 않고 한 줄에: 학교 이름 · 전화(걸기) · 홈페이지. 링크는 44px 누르는 곳. */}
        {(site.phone || site.homepage) && (
          <p class="footer-contact">
            <b>{site.school}</b>
            {site.phone && <><span aria-hidden="true">·</span><a href={`tel:${site.phone}`}>{site.phone}</a></>}
            {site.homepage && <><span aria-hidden="true">·</span><a href={site.homepage}>학교 홈페이지</a></>}
          </p>
        )}
      </div>
    </footer>
    <nav class="tabbar" aria-label="주 메뉴">
      {
        nav.map((n) => (
          <a href={n.to} aria-current={isCurrent(n.to) ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={n.icon} />
            <span set:html={n.label} />
          </a>
        ))
      }
    </nav>
    <ClassSheet />
  </body>
</html>
