---
import '../styles/global.css';
import { site } from '../site.config.ts';
import { href } from '../lib/paths.ts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} | ${site.title}` : site.title;
const path = Astro.url.pathname;
// 휴대폰에서는 아래 탭으로, 넓은 화면에서는 머리글 오른쪽에 보인다. icon은 24×24 선 그림.
const nav = [
  { label: '오늘', short: '오늘', to: href(), icon: '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8 20h8M12 16v4"/>' },
  { label: '알림', short: '알림', to: href('notices/'), icon: '<path d="M6 3h11a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H6z"/><path d="M9 8h6M9 12h6M9 16h4"/>' },
  { label: '학사일정', short: '일정', to: href('schedule/'), icon: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>' },
  ...(site.lostFoundApi
    ? [{ label: '분실물함', short: '분실물', to: href('lost/'), icon: '<path d="M3 8l9-5 9 5v8l-9 5-9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/>' }]
    : []),
  { label: '이용 안내', short: '안내', to: href('about/'), icon: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/>' },
];
const isCurrent = (to: string) => (to === href() ? path === to : path.startsWith(to));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#26443a" />
    <title>{fullTitle}</title>
    <link rel="icon" href={href('favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    <link rel="manifest" href={href('manifest.webmanifest')} />
    <meta name="apple-mobile-web-app-title" content="명지중 알림장" />
    <script is:inline>
      // 고른 학년은 이 기기에만 저장된다. 서버로 보내지 않는다.
      try {
        const g = localStorage.getItem('mjms-grade');
        if (g) document.documentElement.dataset.grade = g;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="wrap">
        <a class="site-name" href={href()}>
          <img src={href('emblem.png')} alt="" width="36" height="37" />
          <span><small>{site.school}</small>알림장</span>
        </a>
        <a class="grade-chip" href="#grade-tray" data-grade-chip hidden>전체 학년</a>
        <nav class="site-nav" aria-label="주 메뉴">
          {nav.filter((n) => n.to !== href()).map((n) => <a href={n.to} aria-current={isCurrent(n.to) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>이 사이트는 로그인이 없고, 방문자의 개인정보나 쿠키를 수집하지 않습니다.</p>
        <p>
          개별 상담과 서류 제출은 학교 공식 창구를 이용해 주세요.
          {site.phone && <> 학교 대표전화 <a href={`tel:${site.phone}`}>{site.phone}</a>.</>}
          {site.homepage && <> <a href={site.homepage}>학교 홈페이지</a></>}
        </p>
      </div>
    </footer>
    <nav class="tabbar" aria-label="아래 메뉴">
      {
        nav.map((n) => (
          <a href={n.to} aria-current={isCurrent(n.to) ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={n.icon} />
            <span>{n.short}</span>
          </a>
        ))
      }
    </nav>
  </body>
</html>
